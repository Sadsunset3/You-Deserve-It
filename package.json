{
  "name": "you-deserve-it",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @ydi/server --filter @ydi/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
