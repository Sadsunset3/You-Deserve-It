PORT=3000
DATABASE_PATH=./data/game.db
SESSION_SECRET=replace-with-at-least-32-characters
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=30000
WEB_ORIGIN=http://localhost:5173

# 微信公众号（免费 Token 验证码）——回调地址指向 https://<域名>/api/wechat/event
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 后台「消息加解密」里安全/兼容模式的 EncodingAESKey（明文模式留空）
WECHAT_ENCODING_AES_KEY=
# 模板消息：验证码推送模板 ID（后台 → 模板消息 → 选用模板后复制 ID）
WECHAT_TEMPLATE_ID=
# 菜单「获取验证码」按钮的事件 key（与后端 WECHAT_MENU_KEY 一致）
WECHAT_MENU_KEY=LOGIN

# 免费 Token 中转 API（验证码通过后可免填用户 Key 建房）
